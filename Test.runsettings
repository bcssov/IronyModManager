<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TargetPlatform>x64</TargetPlatform>
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <Attributes>
              <Exclude>
                <Attribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute$</Attribute>
                <!-- Maintainer-owned coverage boundary since 2020; Reason explains each exclusion. -->
                <Attribute>IronyModManager.Shared.ExcludeFromCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
            <Sources>
              <Include>
                <!-- Business/domain/application layers. -->
                <Source>.*IronyModManager\.(IO|Localization|Models|Parser|Services|Storage|Shared).*</Source>
                <!-- The deliberately unit-tested portion of the Avalonia frontend. -->
                <Source>.*IronyModManager[/\\]Converters[/\\].*</Source>
                <Source>.*IronyModManager[/\\]Implementation[/\\](ViewLocator|ViewResolver|LocalizationResourceProvider)\.cs$</Source>
                <Source>.*IronyModManager[/\\]Implementation[/\\]Config[/\\]ConfigurationLoader\.cs$</Source>
                <Source>.*IronyModManager[/\\]Fonts[/\\]NotoSans.*\.cs$</Source>
              </Include>
              <Exclude>
                <Source>.*\.xaml$</Source>
                <Source>.*\.axaml$</Source>
              </Exclude>
            </Sources>
            <ModulePaths>
              <Include>
                <ModulePath>.*IronyModManager.*</ModulePath>
              </Include>
              <Exclude>
                <!-- Composition plumbing is validated for resolution, not unit coverage. -->
                <ModulePath>.*IronyModManager\.DI.*</ModulePath>
                <!-- Platform integration belongs to functional/platform validation. -->
                <ModulePath>.*IronyModManager\.Platform.*</ModulePath>
                <!-- Match test assembly filenames, not their parent test-project directories. -->
                <ModulePath>(^|.*[/\\])IronyModManager(\.[^/\\]*)?\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
